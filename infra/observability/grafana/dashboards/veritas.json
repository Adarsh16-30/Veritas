{
  "uid": "veritas-reliability",
  "title": "VERITAS — reliability",
  "tags": [
    "veritas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_tag",
        "label": "run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "veritas-prometheus"
        },
        "query": {
          "query": "label_values(veritas_workflows, run_tag)",
          "refId": "run_tag"
        },
        "definition": "label_values(veritas_workflows, run_tag)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Recorded benchmark — every number traces to the results file in the source table (Rule 10)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Benchmark run complete?",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "0 while a run is still being resumed. An incomplete run is not a benchmark result, and docs/results.md withholds the delta.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_bench_complete",
          "legendFormat": "{{config}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "INCOMPLETE",
                  "color": "red"
                },
                "1": {
                  "text": "complete",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "bargauge",
      "title": "Workflows recorded / expected",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Benchmark workflows with a usable result vs the benchmark split size.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_bench_workflows",
          "legendFormat": "{{config}} {{kind}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "table",
      "title": "Source of every benchmark number (Rule 10)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "The results file, commit and completion time behind the veritas_bench_* series.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_bench_info",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Compounding-failure curve — survive[k]",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Fraction of workflows correct at every one of their first k steps (METRICS.md §1.3). A bar marked (incomplete) comes from a run still being resumed and is not the benchmark result.",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_bench_survival_ratio",
          "legendFormat": "{{config}} ({{run}}) · k={{k}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Headline rates",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "End-to-end success, false-commit rate and escalation precision/recall (METRICS.md §1–2). Lower is better for false_commit_rate.",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_bench_rate_ratio",
          "legendFormat": "{{config}} ({{run}}) · {{metric}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Detection by fault class",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Correct terminal action per fault class — the honest weakness map.",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_bench_detection_ratio",
          "legendFormat": "{{fault_class}} · {{config}} ({{run}})",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",
      "title": "Calibration (PRD §1: ECE ≤ 0.05 post-conformal)",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "stat",
      "title": "Conformal router",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Without a fitted calibration artifact the gate routes on the unanimous region and makes no coverage or ECE claim.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_calibration_fitted",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNCALIBRATED — no coverage claim",
                  "color": "orange"
                },
                "1": {
                  "text": "calibrated",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "ECE and coverage (held-out split)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "From results/calibration_curves.json. Empty until scripts/calibrate.py has been run — never estimated.",
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_calibration{metric=~\"ece_pre|ece_post|coverage|brier_post\"}",
          "legendFormat": "{{metric}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "noValue": "not fitted",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "row",
      "title": "Live agent state (Postgres) — Rule 7: every retry and escalation is counted",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "stat",
      "title": "Budget violations (must be 0)",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Workflows over their per-configuration model-call cap. Anything above 0 is a bug (Rule 7).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "sum(veritas_budget_violations{run_tag=~\"$run_tag\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Escalation rate",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Escalated / finished workflows; a configuration with none shows 0%, not a missing bar. On a faulted corpus a high rate can be correct — read it beside detection by class.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "(sum by (config) (veritas_forced_escalation_total{run_tag=~\"$run_tag\"}) or 0 * sum by (config) (veritas_workflows{run_tag=~\"$run_tag\"})) / sum by (config) (veritas_workflows{run_tag=~\"$run_tag\", status=~\"completed|escalated\"})",
          "legendFormat": "{{config}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Metric sources up",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "postgres = live agent state, results = recorded benchmark files.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "veritas_source_up",
          "legendFormat": "{{source}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "bargauge",
      "title": "Workflows by status",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Current state of every workflow in the agent store.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "sum by (config, status) (veritas_workflows{run_tag=~\"$run_tag\"})",
          "legendFormat": "{{config}} · {{status}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Escalations by reason",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Cumulative escalations to a human, by the first token of the escalation reason.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "sum by (config, reason) (veritas_forced_escalation_total{run_tag=~\"$run_tag\"})",
          "legendFormat": "{{config}} · {{reason}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Step retries",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Cumulative attempts beyond the first, per step (Rule 7 caps these at 2 per step).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "sum by (config, step) (veritas_step_retry_total{run_tag=~\"$run_tag\"})",
          "legendFormat": "{{config}} · {{step}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Model-call latency p95",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "p95 of per-attempt executor and verifier call latency over every recorded attempt, interpolated within histogram buckets — coarse at small n.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, config, stage) (veritas_step_latency_seconds_bucket))",
          "legendFormat": "{{config}} · {{stage}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Routes per step",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "description": "Where each recorded attempt went: commit, retry or escalate.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          },
          "refId": "A",
          "expr": "sum by (step, route) (veritas_step_route_total{run_tag=~\"$run_tag\"})",
          "legendFormat": "{{step}} · {{route}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
