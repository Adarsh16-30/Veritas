*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment / secrets — never commit real ERP credentials (Rule 1 real instance)
.env
.env.local
*.key
secrets/

# Graphify — local build tooling, not product code (CLAUDE.md 3)
graphify-out/

# Local Claude configuration
.claude/

# Documentation — keep the README tracked
*.md
!README.md

# Docker local volumes / ERPNext site data
infra/docker-compose/volumes/
sites/

# Trace explorer build output
ui/dist/
ui/node_modules/

# Scratch results only — real results/*.json ARE committed (Rule 10 traceability)
results/*.tmp.json
*.local.json

# OS
.DS_Store
Thumbs.db
