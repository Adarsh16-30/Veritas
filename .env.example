# Copy to .env and fill in. .env is gitignored — it holds real credentials for a
# real ERPNext instance (Rule 1: no mock ever substitutes for these).

# --- ERPNext (real system of record) ---
ERPNEXT_URL=http://localhost:8080
ERPNEXT_SITE=frontend
# Scoped service-user key/secret (NOT System Manager) — created by
# scripts/generate_scoped_api_key.py after the stack is up.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Admin password for first-time bootstrap only (setup wizard, role creation).
ERPNEXT_ADMIN_PASSWORD=admin

# --- Agent state store (Postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=veritas
POSTGRES_USER=veritas
POSTGRES_PASSWORD=veritas

# --- Work queue / per-workflow locks (Redis) ---
REDIS_URL=redis://localhost:6380/0

# --- Company / ledger config created during Phase 1 bootstrap ---
VERITAS_COMPANY=Veritas Test Co
VERITAS_ABBR=VTC
VERITAS_COUNTRY=United States
VERITAS_CURRENCY=USD
VERITAS_FY_START=2026-01-01
VERITAS_FY_END=2026-12-31
VERITAS_COST_CENTER=Main - VTC
VERITAS_WAREHOUSE=Stores - VTC
